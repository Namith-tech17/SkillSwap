{
  "name": "skillswap-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test:db": "npm --prefix server run test:db",
    "test:security": "npm --prefix server run test:security",
    "test:all": "npm --prefix server run test:all"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
